; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SickWorld"
config/description="MMORPG 3D : des voyageurs temporels réparent l'histoire, une époque à la fois."
run/main_scene="res://scenes/interface/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Compte="*res://scripts/autoload/compte.gd"
Controles="*res://scripts/autoload/controles.gd"
Donnees="*res://scripts/autoload/donnees.gd"
Regles="*res://scripts/autoload/regles.gd"
Reseau="*res://scripts/autoload/reseau.gd"
QualiteGraphique="*res://scripts/autoload/qualite_graphique.gd"
Cartographe="*res://scripts/autoload/cartographe.gd"
Audio="*res://scripts/autoload/audio.gd"
Options="*res://scripts/autoload/options.gd"
Conseils="*res://scripts/autoload/conseils.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[dotnet]

project/assembly_name="SickWorld"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96

[shader_globals]

pluie_impacts={
"type": "float",
"value": 1.0
}
